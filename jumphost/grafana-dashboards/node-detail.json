    {
      "datasource": {
        "type": "prometheus",
        "uid": "P4DEAB3C3757C9E93"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 13,
        "y": 0
      },
      "options": {
        "colorMode": "none",
